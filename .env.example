# Copie para .env se quiser mudar os valores. O Docker Compose lê este arquivo.
# Os valores abaixo são apenas para desenvolvimento local. Nunca use em produção.
DB_NAME=horadaboia
DB_USER=horadaboia
DB_PASSWORD=horadaboia
DB_ROOT_PASSWORD=root

# Necessário apenas para subir a aplicação pelo Docker Compose (perfil app)
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Endereço(s) do frontend autorizados a chamar a API (separados por vírgula, sem barra no final)
CORS_ORIGENS=http://localhost:5500

# Previstos para a criação do administrador inicial (US02 e US03)
ADMIN_EMAIL=admin@horadaboia.local
ADMIN_PASSWORD=troque-esta-senha
